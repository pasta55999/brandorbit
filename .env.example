# Copy to .env and fill in what you have. Everything is optional: with no keys BrandOrbit runs in Demo Mode.

# --- Live providers (either or both) ---------------------------------------
# OpenAI Responses API with web search (citations supported)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Messages API with web search tool (citations supported)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Reliability limits -----------------------------------------------------
BRANDORBIT_TIMEOUT_S=45
BRANDORBIT_MAX_RETRIES=2
BRANDORBIT_MAX_PROMPTS_PER_RUN=25
BRANDORBIT_MAX_CALLS_PER_RUN=60

# --- Website audit -----------------------------------------------------------
# Live fetching of product pages is off by default. Set to true to allow at most 5 GET requests
# per audit, honouring robots.txt.
BRANDORBIT_ALLOW_WEBSITE_FETCH=false

# --- Storage -----------------------------------------------------------------
# BRANDORBIT_DB=./brandorbit.db
